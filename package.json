{
  "name": "embeddingviz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.mjs vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "node scripts/dev-server.mjs vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:deps": "node scripts/dependency-smoke.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@sentry/react": "^10.51.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vercel/analytics": "^1.6.1",
    "@vitejs/plugin-react": "^6.0.1",
    "lucide-react": "^1.14.0",
    "ml-pca": "^4.1.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "typescript": "^6.0.3",
    "umap-js": "^1.4.0",
    "vite": "^8.0.10"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "^1.59.1",
    "@sentry/vite-plugin": "^5.2.1",
    "eslint": "9.39.1",
    "globals": "16.4.0",
    "jsdom": "^29.1.1",
    "typescript-eslint": "8.66.0",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "@huggingface/transformers": {
      "onnxruntime-node": {
        "adm-zip": "0.6.0"
      },
      "sharp": "0.35.3"
    }
  }
